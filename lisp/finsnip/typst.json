{
  "--- Document Structure (Manual) ---": {},
  "Heading": { "prefix": "h1.", "body": "= ${1:Title}", "scope": "typst-ts", "auto": false },
  "Equation Block": { "prefix": "eq.", "body": "$ ${1:equation} $", "scope": "typst-ts", "auto": false },
  "Grid": { "prefix": "grid.", "body": "grid(\n  columns: (${1:1fr, 1fr}),\n  gutter: ${2:1em},\n  ${3:[Cell 1], [Cell 2]}\n)", "scope": "typst-ts", "auto": false },
  "Table": { "prefix": "table.", "body": "table(\n  columns: (${1:1fr, 1fr}),\n  [${2:Header 1}], [${3:Header 2}],\n  [${4:Cell 1}], [${5:Cell 2}]\n)", "scope": "typst-ts", "auto": false },

  "--- Document Structure (Auto) ---": {},
  "List": { "prefix": "list.", "body": "- ${1:item}\n- ${2:item}", "scope": "typst-ts", "auto": true },
  "Bold": { "prefix": "bb.", "body": "*${1:bold}*", "scope": "typst-ts", "auto": true },
  "Italic": { "prefix": "ii.", "body": "_${1:italic}_", "scope": "typst-ts", "auto": true },

  "--- Greek Letters (Auto) ---": {},
  "alpha": { "prefix": ";a", "body": "alpha", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "beta": { "prefix": ";b", "body": "beta", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "gamma": { "prefix": ";g", "body": "gamma", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "delta": { "prefix": ";d", "body": "delta", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "epsilon": { "prefix": ";e", "body": "epsilon", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "zeta": { "prefix": ";z", "body": "zeta", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "eta": { "prefix": ";h", "body": "eta", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "theta": { "prefix": ";t", "body": "theta", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "iota": { "prefix": ";i", "body": "iota", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "kappa": { "prefix": ";k", "body": "kappa", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "lambda": { "prefix": ";l", "body": "lambda", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "mu": { "prefix": ";m", "body": "mu", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "nu": { "prefix": ";n", "body": "nu", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "xi": { "prefix": ";x", "body": "xi", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "pi": { "prefix": ";p", "body": "pi", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "rho": { "prefix": ";r", "body": "rho", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "sigma": { "prefix": ";s", "body": "sigma", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "tau": { "prefix": ";u", "body": "tau", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "phi": { "prefix": ";f", "body": "phi", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "psi": { "prefix": ";c", "body": "psi", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "omega": { "prefix": ";w", "body": "omega", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },

  "--- Math (Auto) ---": {},
  "Summation": { "prefix": "sum.", "body": "sum_(i=${1:1})^${2:n} ${3:x_i}", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "Integral": { "prefix": "int.", "body": "integral_(${1:-oo})^(${2:oo}) ${3:f(x)} dx", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "Fraction": { "prefix": "frac.", "body": "(${1:num}) / (${2:den})", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "Matrix": { "prefix": "mat.", "body": "mat(${1:1, 2; 3, 4})", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true },
  "Square Root": { "prefix": "sqrt.", "body": "sqrt(${1:x})", "scope": "typst-ts", "context": "finsnip-typst-in-math-p", "auto": true }
}
